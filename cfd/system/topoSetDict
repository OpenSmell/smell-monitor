// Cut the three nostril patches and the fan outlet out of the box faces.
// Coordinates in metres (SI). The boxes follow the mechanical constants, so a
// nostril-position change cannot silently leave the airflow case behind.
actions
(
    {
        name    inlet0;
        type    faceSet;
        action  new;
        source  patchToFace;
        patch   inletFace;
    }
    {
        name    inlet0;
        type    faceSet;
        action  subset;
        source  boxToFace;
        box     (0.044 0.003 0.030) (0.050 0.003 0.036);
    }

    {
        name    inlet1;
        type    faceSet;
        action  new;
        source  patchToFace;
        patch   inletFace;
    }
    {
        name    inlet1;
        type    faceSet;
        action  subset;
        source  boxToFace;
        box     (0.058 0.003 0.030) (0.064 0.003 0.036);
    }

    {
        name    inlet2;
        type    faceSet;
        action  new;
        source  patchToFace;
        patch   inletFace;
    }
    {
        name    inlet2;
        type    faceSet;
        action  subset;
        source  boxToFace;
        box     (0.072 0.003 0.030) (0.078 0.003 0.036);
    }

    {
        name    outlet;
