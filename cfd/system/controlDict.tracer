FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// Second run, on the converged flow field: a unit step of a passive tracer at
// the inlets.  t63 at a probe is that point's exchange time.
application     scalarTransportFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         40;
deltaT          0.02;
writeControl    runTime;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    probes
    {
        type            probes;
        libs            ("libsampling.so");
        fields          (T);
        probeLocations
        (
            (0.303279 0.210526 0.550000)   // A0
            (0.303279 0.421053 0.550000)   // A1
            (0.303279 0.631579 0.550000)   // A2
            (0.303279 0.842105 0.550000)   // A3
            (0.696721 0.210526 0.550000)   // D0
            (0.696721 0.421053 0.550000)   // D1
            (0.696721 0.631579 0.550000)   // D2
            (0.696721 0.842105 0.550000)   // D3
            (0.500000 0.047368 0.238333)   // bypass
            (0.500000 0.991228 0.550000)   // outlet
        );
    }
}
