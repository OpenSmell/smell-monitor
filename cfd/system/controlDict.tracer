FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// Second run, on the converged flow field: a unit step of a passive tracer at
// the inlets.  t63 at a probe is that point's exchange time.
application     scalarTransportFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         40;
deltaT          0.02;
writeControl    runTime;
writeInterval   1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    probes
    {
        type            probes;
        libs            ("libsampling.so");
        fields          (T);
        probeLocations
        (
            (22.0 91.0 40.5)   // A0
            (48.0 91.0 40.5)   // A1
            (74.0 91.0 40.5)   // A2
            (100.0 91.0 40.5)   // A3
            (29.5 49.0 40.5)   // D0
            (50.5 49.0 40.5)   // D1
            (71.5 49.0 40.5)   // D2
            (92.5 49.0 40.5)   // D3
            (61.0 15.0 14.0)   // bypass
            (61.0 105.0 25.0)   // outlet
        );
    }
}
