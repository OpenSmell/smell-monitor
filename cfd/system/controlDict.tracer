FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// Second run, on the converged flow field: a unit step of a passive tracer at
// the inlets.  t63 at a probe is that point's exchange time.
application     scalarTransportFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         8;
deltaT          4e-4;
writeControl    runTime;
writeInterval   0.25;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    probes
    {
        type            probes;
        libs            ("libsampling.so");
        fields          (T);
        probeLocations
        (
            (0.037000 0.024000 0.033000)   // A0
            (0.037000 0.048000 0.033000)   // A1
            (0.037000 0.072000 0.033000)   // A2
            (0.037000 0.096000 0.033000)   // A3
            (0.085000 0.024000 0.033000)   // D0
            (0.085000 0.048000 0.033000)   // D1
            (0.085000 0.072000 0.033000)   // D2
            (0.085000 0.096000 0.033000)   // D3
            (0.061000 0.005400 0.014300)   // bypass
            (0.061000 0.109000 0.033000)   // outlet
        );
    }
}
