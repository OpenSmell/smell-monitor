flowchart LR
    subgraph POWER["Power Tree"]
        USB["USB-C 5V"] --> NET5["5V NET"]
        NET5 --> FAN["Fan (PWM MOSFET)"]
        NET5 --> AH["Analog +5V (J2-J9)"]
        NET5 --> BZ["Buzzer"]
        NET5 --> LDO["U7 AMS1117-3.3"]
        LDO --> NET3["3.3V NET"]
    end

    subgraph MASTER["Master I2C Bus"]
        ESP["ESP32-WROOM-32E<br/>GPIO21 SDA / GPIO22 SCL"] --> ADC1["U2 ADS1115 0x48"]
        ESP --> ADC2["U3 ADS1115 0x49"]
        ESP --> MUX["U4 TCA9548A 0x70"]
        ESP --> SHT["U5 SHT31 0x44"]
        ESP --> OLED["U6 SSD1306 0x3C"]
    end

    subgraph SENSORS["Sensor Banks"]
        AO["AO (divider -> 2.5V)"] --> ADC1
        AO --> ADC2
        DO["DO -> GPIO"] --> ESP
        MUX -->|"SC0..SC7 segmented"| DIG["Digital slots J10-J17<br/>3V3 GND SDA SCL INT CTRL"]
    end

    NET3 --> ESP
    NET3 --> ADC1
    NET3 --> ADC2
    NET3 --> MUX
    NET3 --> SHT
    NET3 --> OLED
    NET3 --> DIG

    style ESP fill:#111827,color:#fff
    style LDO fill:#166534,color:#fff
    style MUX fill:#7c2d12,color:#fff