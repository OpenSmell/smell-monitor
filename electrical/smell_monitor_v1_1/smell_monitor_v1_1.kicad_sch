  (text "POWER SUPPLY" (at 25.0 37.0 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 7299bf80-0bbd-4aa7-a46b-0cf410ef39bf)
  )
  (text "USB � UART BRIDGE" (at 25.0 92.62 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 15ff86cd-63b9-4d05-930e-15ba60e27a8c)
  )
  (text "MICROCONTROLLER" (at 25.0 156.72 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 1b437d8e-a970-449a-9f6d-407ac1ed57e7)
  )
  (text "ANALOG INPUT  (2 x ADS1115)" (at 25.0 275.84000000000003 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 818917a7-2cae-4194-af27-eb162a3063ac)
  )
  (text "I2C MULTIPLEXER  (TCA9548A)" (at 427.0 37.0 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid f4506590-cd42-45cb-a202-9976bd9b681e)
  )
  (text "SENSOR / ID" (at 427.0 111.25999999999999 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 6988616d-aec7-4760-9786-6f2cb84e5a4a)
  )
  (text "OUTPUTS" (at 427.0 152.5 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 32c13da8-fddc-4846-a3d4-ac46e0b1e7b6)
  )
  (text "SLOTS  (1x6 + Qwiic)" (at 427.0 210.66 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 17337152-c6bf-44f2-beee-75c4b451d674)
  )
  (text "SLOT FRONT-END  (AO divider, DO series)" (at 427.0 293.36 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 4585648c-3d17-4d8f-9372-827635ff4c9f)
  )
  (text "BUS PULL-UPS" (at 427.0 392.98 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid eceee109-a248-45b4-b5d3-001be1630602)
  )
  (text "NOTES" (at 25.0 473.0 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 8546bdc3-f33d-438d-b00a-ecc64b82abf2)
  )
  (text "1.  +3V3 is generated by U7 (AMS1117CD-3.3) from the USB-C +5V rail; every IC has a 100nF decoupling cap at its supply pin."
    (at 27.0 482.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid 08751c85-871c-4aa4-936a-52079803bf3b)
  )
  (text "2.  EVERY SLOT  J2..J9 = 1:+5V  2:GND  3:AO  4:DO  5:3V3  6:ID   (a 4-pin MQ-type module seats on pins 1-4)."
    (at 27.0 491.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid 02947544-0081-4399-8fce-27d024b234a9)
  )
  (text "3.  QWIIC PORT  J11..J18 = 1:GND  2:3V3  3:SDA  4:SCL   (each port is one TCA9548A channel; channel n <-> slot n)."
    (at 27.0 500.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid 23841d38-4b2e-4cba-a016-9886400929da)
  )
  (text "4.  I2C ADDRESSES  ADS1115 0x48 (slots 0-3) / 0x49 (slots 4-7)   TCA9548A 0x70   SHT31 0x44."
    (at 27.0 509.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid 8508ebbc-3042-4d1c-be1c-32d407013e98)
  )
  (text "5.  1-Wire ID: all eight slot ID pins share one open-drain bus with a 4.7k pull-up; each module carries a unique 64-bit ROM."
    (at 27.0 518.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid 1a5a2cd0-e524-499f-aaaa-d52d5d10ae1a)
  )
  (text "6.  S1 = MEASURE (start a sniff cycle)   S2 = BOOT   S3 = RESET.   Manual flashing, no auto-reset transistors."
    (at 27.0 527.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid 539e84fb-4fe6-40f8-a1da-2b4ee04adf60)
  )
  (text "7.  Connectivity is carried by net-name labels; the authoritative pin/net model is electrical/board.py (validated, ERC-clean)."
    (at 27.0 536.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid 15f1b357-b0bc-47fe-a0d0-f8b578bd6d93)
  )
  (text "8.  NC = not connected (no-connect flag placed).   All dimensions mm; passives 0603 unless noted."
    (at 27.0 545.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid e98f9b21-1ad8-4a2e-8a52-fb68bfd898f6)
  )

  (label "+5V" (at 38.0 71.0 0)
    (effects (font (size 1.27 1.27)))
    (uuid b4ef04ce-5660-41d5-9fcd-2231af044c4e)
  )
