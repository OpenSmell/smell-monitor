  (text "POWER SUPPLY" (at 25.0 37.0 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 8f8e907f-7ee8-4e2f-b3f4-cf165a3af77b)
  )
  (text "USB � UART BRIDGE" (at 25.0 92.62 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 1b834a45-1b57-4032-aced-9b0723a7dc5a)
  )
  (text "MICROCONTROLLER" (at 25.0 156.72 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 36f0e76c-2399-4a3d-a893-702c0b3f9ca8)
  )
  (text "ANALOG INPUT  (ADS1115)" (at 25.0 275.84000000000003 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 402c9b2a-4d87-48dc-af0b-ac5b9842d168)
  )
  (text "I2C MULTIPLEXER  (TCA9548A)" (at 427.0 37.0 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 518ee451-4744-4fd2-8b26-781de32acbd2)
  )
  (text "SENSOR / DISPLAY" (at 427.0 111.25999999999999 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid e84311e1-33d7-4fc8-83a7-9db15943c76d)
  )
  (text "OUTPUTS" (at 427.0 157.57999999999998 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid e854751f-77af-416a-9dcd-67fc2da470b2)
  )
  (text "ANALOG SLOTS" (at 427.0 215.73999999999998 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid e64cfac2-e2a0-4523-8014-bca544e9e69e)
  )
  (text "DIGITAL SLOTS" (at 427.0 251.89999999999998 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid c44b11c8-0e95-4f02-8f73-2632c2227cea)
  )
  (text "NOTES" (at 25.0 473.0 0)
    (effects (font (size 3.0 3.0) bold) (justify left top))
    (uuid 76520379-3b9b-4299-90fc-de071ce244be)
  )
  (text "1.  +3V3 is generated by U7 (AMS1117CD-3.3) from the USB-C +5V rail; every IC has a 100nF decoupling cap at its supply pin."
    (at 27.0 482.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid e4e74650-bb6d-4cc0-9e6c-cfd022ac22fa)
  )
  (text "2.  ANALOG SLOTS  J2..J5 = 1:+5V  2:GND  3:AO  4:DO  5:3V3   (MQ-type module seats on pins 1-4)."
    (at 27.0 491.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid 75830fa2-c692-4367-bc2f-9e8566415e21)
  )
  (text "3.  DIGITAL SLOTS  J6..J9 = 1:3V3  2:GND  3:SDA  4:SCL  5:INT  6:CTRL  (each slot is one TCA9548A channel)."
    (at 27.0 500.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid c6835280-ffc9-4fc4-985c-3f1a5d484511)
  )
  (text "4.  I2C ADDRESSES  ADS1115 0x48   TCA9548A 0x70   SHT31 0x44   OLED 0x3C."
    (at 27.0 509.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid 25e8874d-6f60-477e-b6d2-44544ce6f1b7)
  )
  (text "5.  S1 = MEASURE (start a sniff cycle)   S2 = BOOT   S3 = RESET.   Manual flashing, no auto-reset transistors."
    (at 27.0 518.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid c644771e-d3fc-4755-a19f-e0a6f34b71ed)
  )
  (text "6.  Connectivity is carried by net-name labels; the authoritative pin/net model is electrical/board.py (validated, ERC-clean)."
    (at 27.0 527.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid 43898bbf-c970-4296-b5f7-d024002f5cfa)
  )
  (text "7.  NC = not connected (no-connect flag placed).   All dimensions mm; passives 0603 unless noted."
    (at 27.0 536.0 0)
    (effects (font (size 2.2 2.2)) (justify left top))
    (uuid 0c13d028-339a-4293-9148-50fae1aac82f)
  )

