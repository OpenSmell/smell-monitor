build/
dist/

# Generated CAD / drawings
#   committed deliverables:
#     mechanical/drawings/sheets/*.dxf + *.pdf   editable sheets + plot
#     mechanical/drawings/model_hlr.json         the gate's input (so a fresh
#                                                clone can run the CAD gate)
#     mechanical/freecad/smell_monitor*.STEP     the 3D part data
#     mechanical/freecad/smell_monitor_*.stl     print meshes
mechanical/freecad/*.FCStd
mechanical/freecad/*.FCStd1
mechanical/drawings/sheets/*.png

# Secrets
.env
*.pem
.opencode
